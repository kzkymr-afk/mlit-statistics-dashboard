{
  "name": "mlit-statistics-panel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev:pages": "next dev",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:pages && node --test tests/rendered-html.test.mjs tests/chart-scale.test.mjs",
    "test:data": "node --test tests/static-data.test.mjs",
    "test:system": "node --test tests/statistics-system.test.mjs",
    "test:system-public": "node --test tests/system-public-data.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:build-local": "node --expose-gc scripts/build-local-database.mjs",
    "data:export-pages": "node scripts/export-pages-data.mjs",
    "data:export-system-pages": "node scripts/export-system-pages-data.mjs",
    "data:prepare-pages": "npm run db:build-local && npm run data:export-pages",
    "sync:estat-api": "node --env-file-if-exists=.env.local scripts/sync-estat-api.mjs",
    "sync:estat-api:resume": "node --env-file-if-exists=.env.local scripts/sync-estat-api.mjs --resume",
    "sync:estat-api:management": "node --env-file-if-exists=.env.local scripts/sync-estat-api.mjs --resume --dataset building-starts-monthly,orders-major50-monthly,construction-output,construction-deflator,construction-investment,construction-work",
    "sync:estat-excel": "node --env-file-if-exists=.env.local scripts/sync-estat-excel-supplements.mjs",
    "data:publish-system": "node scripts/export-system-pages-data.mjs",
    "data:publish-system:renovation": "MLIT_SYSTEM_ONLY_DATASET=renovation node scripts/export-system-pages-data.mjs",
    "data:publish-system:management": "MLIT_SYSTEM_ONLY_DATASET=building-starts-monthly,orders-major50-monthly,construction-output,construction-deflator,construction-investment,construction-work,construction-labor,construction-materials,building-stock node scripts/export-system-pages-data.mjs",
    "sync:estat-inventory": "node --env-file-if-exists=.env.local scripts/sync-estat-api.mjs --inventory-only",
    "sync:data": "node --experimental-strip-types scripts/sync-official-data.mjs",
    "sync:building-annual": "node scripts/sync-building-annual-files.mjs && node scripts/build-building-annual-catalog.mjs",
    "catalog:building-annual": "node scripts/build-building-annual-catalog.mjs",
    "sync:orders-major50-annual": "node scripts/sync-orders-major50-annual-files.mjs && node scripts/build-orders-major50-annual-catalog.mjs",
    "catalog:orders-major50-annual": "node scripts/build-orders-major50-annual-catalog.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
